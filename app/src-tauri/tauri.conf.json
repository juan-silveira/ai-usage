{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Usage",
  "version": "0.3.0",
  "identifier": "io.github.ai-usage",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI Usage",
        "width": 360,
        "height": 440,
        "minWidth": 300,
        "minHeight": 200,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "AI usage limits (Claude, Codex) in the system tray",
    "longDescription": "Monitor for the usage limits and live sessions of Claude Code and OpenAI Codex, with alerts, a floating widget and a system tray item.",
    "category": "DeveloperTool",
    "publisher": "Juan Silveira",
    "homepage": "https://github.com/juan-silveira/ai-usage",
    "license": "MIT",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3OTU3MDA1RjVDQzEyNTAKUldSUUVzejFCWENWbHpMNXg3c1RhZFpYcWpZNm1YRGdRZU1rRnp4MlZ6Zmo5Z0pNeUVTd1J5bDMK",
      "endpoints": [
        "https://github.com/juan-silveira/ai-usage/releases/latest/download/latest.json"
      ]
    }
  }
}
