{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IA Usage",
  "version": "0.1.0",
  "identifier": "io.github.ia-usage",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "IA Usage",
        "width": 360,
        "height": 440,
        "minWidth": 300,
        "minHeight": 200,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
