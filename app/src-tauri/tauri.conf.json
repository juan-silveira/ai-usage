{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Usage",
  "version": "0.1.0",
  "identifier": "io.github.ai-usage",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI Usage",
        "width": 360,
        "height": 440,
        "minWidth": 300,
        "minHeight": 200,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Uso das IAs (Claude, Codex) na barra do sistema",
    "longDescription": "Monitor de limites de uso e sessões ao vivo do Claude Code e do OpenAI Codex, com alertas, widget flutuante e item na barra do sistema.",
    "category": "DeveloperTool",
    "publisher": "Juan Silveira",
    "homepage": "https://github.com/juan-silveira/ai-usage",
    "license": "MIT"
  }
}
